#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NUM   1
#define VIM   2
#define SYM   3
#define MOUSE 4
#define FN    5
#define BLE   6

/ {
    combos {
        compatible = "zmk,combos";
        // Hold both "main" thumb keys (SPACE + RET) together to reach
        // the BLE layer. They're physically adjacent -- the two
        // innermost thumb keys -- so it's a natural chord.
        combo_ble {
            timeout-ms = <50>;
            key-positions = <38 39>;
            bindings = <&mo BLE>;
            layers = <BASE>;
        };
    };

    behaviors {
        // Home-row mods.
        // Mirrors kanata: (tap-hold $tap-time $hold-time key mod) with
        // tap-time=150 hold-time=200.
        // ZMK's "tap-preferred" flavor is a pure timer-based decision
        // (a hold only fires once tapping-term-ms elapses; other keys
        // pressed in the meantime do NOT force a hold) -- this is exactly
        // how kanata's plain tap-hold behaves, and it's what gives it that
        // fast, non-laggy feel instead of the "wait and see" delay you get
        // from hold-preferred/balanced flavors.
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Layer-tap keys (tab / F17 / F18 / quote).
        // Mirrors kanata's (tap-hold 150 150 ...) -- tap-time == hold-time,
        // so the layer engages the instant 150ms is up, and tap fires
        // instantly on release before that.
        lt_fast: layer_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp ESC          &kp Q            &kp W            &kp E            &kp R          &kp T       &kp Y   &kp U            &kp I            &kp O             &kp P              &kp BSPC
                &lt_fast VIM TAB &hm LCTRL A      &hm LSHFT S      &hm LALT D       &hm LGUI F     &kp G       &kp H   &hm RGUI J       &hm RALT K       &hm RSHFT L       &hm RCTRL SEMI     &kp SQT
                &kp GRAVE        &kp Z            &kp X            &kp C            &kp V          &kp B       &kp N   &kp M            &kp COMMA        &kp DOT           &kp FSLH           &kp BSLH
                                                   &none            &lt_fast SYM F17 &kp SPACE      &kp RET     &lt_fast NUM F18 &mo FN
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
                &trans   &trans  &trans  &trans  &trans  &trans      &trans     &trans       &trans       &trans     &trans    &trans
                &trans   &kp N1  &kp N2  &kp N3  &kp N4  &kp N5      &kp C_RW   &kp C_VOL_DN &kp C_VOL_UP &kp C_FF   &trans    &trans
                &trans   &kp N6  &kp N7  &kp N8  &kp N9  &kp N0      &trans     &trans       &trans       &trans     &trans    &trans
                                          &trans  &trans  &trans      &trans     &trans       &trans
            >;
        };

        vim {
            display-name = "VIM";
            bindings = <
                &trans   &trans  &trans  &trans  &trans  &trans      &trans    &trans     &trans   &trans      &trans  &trans
                &trans   &trans  &trans  &trans  &trans  &trans      &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT   &trans  &trans
                &trans   &trans  &trans  &trans  &trans  &trans      &trans    &trans     &trans   &trans      &trans  &trans
                                          &trans  &trans  &kp C_PP    &kp C_MUTE &trans    &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &trans   &trans  &trans    &trans     &trans     &trans        &trans     &trans     &trans     &trans   &trans  &trans
                &trans   &trans  &kp LBKT  &kp LPAR   &kp LBRC   &kp EQUAL     &kp PLUS   &kp RBRC   &kp RPAR   &kp RBKT &trans  &trans
                &trans   &trans  &trans    &trans     &trans     &kp UNDER     &kp MINUS  &trans     &trans     &trans   &trans  &trans
                                            &trans     &trans     &trans        &trans     &trans     &trans
            >;
        };

        mouse {
            // Auto-activated by the trackpad hardware itself while a
            // finger is touching it (is_touching_processor -> &mo 4 in
            // toucan.dtsi) -- not something reached by a key. Thumb keys
            // become click buttons for the duration of the touch, mirroring
            // stock Toucan2's "MOU" layer.
            display-name = "MOUSE";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp RCLK &mkp MCLK &mkp LCLK           &mkp LCLK &mkp MCLK &mkp RCLK
            >;
        };

        fn {
            display-name = "FN";
            bindings = <
                &trans  &trans  &trans  &trans  &kp F11  &kp F12      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5       &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10      &trans  &trans  &trans  &trans  &trans  &trans
                                         &trans  &trans   &trans       &trans  &trans  &trans
            >;
        };

        ble {
            display-name = "BLE";
            bindings = <
                &trans  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans     &trans  &trans  &bt BT_CLR_ALL
                &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &bt BT_CLR &trans  &trans  &trans
                &trans  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans     &trans  &trans  &trans
                                                     &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
